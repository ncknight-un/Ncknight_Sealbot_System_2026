<launch>
  <arg name="use_camera" default="true"/>
  <arg name="use_sonar" default="true"/>
  <arg name="use_apriltag" default="false"/>
  <arg name="use_tag_zero_frames" default="false"/>
  <arg name="start_mavros" default="true"/>
  <arg name="fcu_url" default="udp://0.0.0.0:14551@"/>

  <!-- Frames first, so TF is available when sensors start publishing -->
  <include file="$(find-pkg-share data_collection)/launch/vehicle_description.launch.xml"/>

  <!-- Sensors (Ping360 & Camera)-->
  <include file="$(find-pkg-share data_collection)/launch/sensors.launch.xml">
    <arg name="use_camera" value="$(var use_camera)"/>
    <arg name="use_sonar" value="$(var use_sonar)"/>
    <arg name="start_mavros" value="$(var start_mavros)"/>
    <arg name="fcu_url" value="$(var fcu_url)"/>
  </include>

  <!-- Perception (rectify + AprilTag); needs use_camera -->
  <include file="$(find-pkg-share apriltag_bringup)/launch/apriltag.launch.xml" if="$(var use_apriltag)"/>

  <!-- Panel zero frames (camera_optical_frame -> tag_N_zero) from config/panel_zero.yaml;
       run panel_calibration.lhttps://www.marriott.com/einterface/v5/CHIDR?AT=CONNECTED&Z=GUEST&U=ADDED&SP=PLAN1&DURATION=6&U_URL=https%3A%2F%2Fsnapx-us1.safetynetaccess.com%2Fapi%2Fv1%2Fgpnsv5%2F2665%2F1000691%2Fupgrade%3Fdo%3Dchooser%26UI%3D09051d%26NI%3D0050e809051d%26UIP%3D12.233.117.131%26MA%3D54E4EDA31218%26RN%3D1000%2BWireless%2BGuest%26PORT%3D1000%26ZONE%3DGuest%26RAD%3Dyes%26PP%3Dno%26PMS%3Dyes%26SIP%3D172.20.5.163%26OS%3Dhttp%253A%252F%252Fwww.marriotwifi.com%252F%26H%3D3b7ec4ec5702bee459d6709d401bc65faunch.xml and rebuild first -->
  <include file="$(find-pkg-share data_collection)/launch/tag_zero_frames.launch.xml" if="$(var use_tag_zero_frames)"/>
</launch>
