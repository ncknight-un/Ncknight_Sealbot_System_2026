<?xml version="1.0"?>
<!--
  Minimal BlueROV2 frame tree for data collection (TF only, no dynamics).

  base_link is at the center of the mesh (bluerov2_gz, models/bluerov2).
  The sonar joint was replaced with a hand measurement from the vehicle center:
  4.5 in forward, 4.5 in right (y = -0.1143), 7 in up.

  camera_link is hand-measured (see below).
  Frames: x forward, y left, z up (base_link / camera_link / sonar).
-->
<robot name="bluerov2">

  <link name="base_link">
    <visual>
      <!-- Mesh and scale from bluerov2_gz (models/bluerov2/meshes/bluerov2.dae) -->
      <geometry>
        <mesh filename="package://data_collection/meshes/bluerov2.dae" scale="0.025 0.025 0.025"/>
      </geometry>
    </visual>
  </link>

  <!-- Ping360: frame name must match the ping360_node "frame" parameter ("sonar") -->
  <link name="sonar">
    <visual>
      <geometry><cylinder length="0.035" radius="0.024"/></geometry>
      <material name="green"><color rgba="0.1 0.8 0.2 1"/></material>
    </visual>
  </link>
  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar"/>
    <origin xyz="0.1143 -0.1143 0.1778" rpy="0 0 0"/>
  </joint>

  <!-- Camera system: 0.0635 m (2.5 in) forward, centered, 0.1778 m (7 in) below base_link.
       Hand-measured; orientation assumed to look straight forward (rpy 0). TODO: confirm. -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0635 0 -0.1778" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame (z forward, x right, y down); matches camera_frame_id in sealbot_camera.launch.xml -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

</robot>
