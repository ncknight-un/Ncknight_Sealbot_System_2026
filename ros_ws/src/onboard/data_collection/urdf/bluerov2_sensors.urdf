<?xml version="1.0"?>
<!-- Blue ROV URDF with Sonar and Sealbot Additions -->
<robot name="bluerov2">

  <link name="base_link">
    <visual>
      <!-- Mesh and scale (inches in CAD to meters in ROS) from bluerov2_gz (models/bluerov2/meshes/bluerov2.dae) -->
      <geometry>
        <mesh filename="package://data_collection/meshes/bluerov2.dae" scale="0.0254 0.0254 0.0254"/>
      </geometry>
    </visual>
  </link>

  <!-- Ping360: frame name must match the ping360_node "frame" parameter ("sonar") -->
  <link name="sonar">
    <visual>
      <!-- Blue Robotics PING360-ASM CAD (cad.bluerobotics.com), cropped to the body, in meters,
           origin at the body center. Mesh z is the rotation axis. -->

      <!-- Rotate the Sonar meth upright -->
      <origin xyz="0 0 0" rpy="1.5707 0.0 1.5707"/>  
      <geometry><mesh filename="package://data_collection/meshes/ping360.stl"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.9 1"/></material>
    </visual>
  </link>
  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar"/>
    <origin xyz="0.1143 -0.1143 0.1778" rpy="0 0 0"/>
  </joint>

  <!-- Sealbot System: Added mesh file for Sealbot CAD file (Scaled from mm to meters in ROS)-->
  <link name="sealbot">
    <visual>
      <!-- Rotate the Sealbot System 90 deg -->
      <origin xyz="0 0 0" rpy="0.0 0.0 1.5707"/>
      <geometry>
        <mesh filename="package://data_collection/meshes/Sealbot_Assembly.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"><color rgba="0.0 0.0 0.0 0.25"/></material>
    </visual>
  </link>
  <joint name="sealbot_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sealbot"/>
    <!-- Shift sealbot body visual to appear attached at correct location -->
    <origin xyz="-0.0125 0 0.0725" rpy="0 0 0"/>
  </joint>

  <!-- Camera system: 0.0635 m (2.5 in) forward, centered, 0.1778 m (7 in) below base_link.
       Hand-measured; orientation assumed to look straight forward (rpy 0). TODO: confirm. -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0225 0 -0.1778" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame (z forward, x right, y down); matches camera_frame_id in sealbot_camera.launch.xml -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>



</robot>
